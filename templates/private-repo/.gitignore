# 组合脚本生成的变体简历（data/ 才是真相源，重新组合即可恢复）
resumes/*.yml

# 历史版本产物缓存（从 GitHub CI 拉取）
resumes/history/

# YAMLResume 构建产物
resumes/*.pdf
resumes/*.tex
resumes/*.aux
resumes/*.log
resumes/*.out
resumes/*.html
resumes/*.md
resumes/*.docx
resumes/*.synctex.gz

# 证件照事务临时/备份文件（进程中断后的恢复产物，下次操作自动清理）
assets/.profile-photo-*.tmp
assets/.profile-photo-*.bak

# 系统/编辑器文件
.DS_Store
Thumbs.db
.idea/
.vscode/

# Python 缓存
__pycache__/
*.pyc
