{
  "name": "resume-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "可视化简历管理系统：管理私有数据仓的信息全集，按标签动态组稿，内置 YAML 编辑 / PDF 预览 / Git 同步看板",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "smoke:photo": "npm run build && node scripts/smoke-photo-crop.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "^1.94.0",
    "adm-zip": "^0.6.0",
    "diff": "^9.0.0",
    "express": "^4.22.2",
    "https-proxy-agent": "^9.1.0",
    "isomorphic-git": "^1.40.5",
    "jpeg-js": "^0.4.4",
    "js-yaml": "^4.1.0",
    "marked": "^18.0.9",
    "pngjs": "^7.0.0",
    "react-easy-crop": "^6.2.3",
    "react-pdf": "^10.4.1",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.4",
    "lucide-react": "^0.454.0",
    "pdfjs-dist": "^5.4.296",
    "puppeteer-core": "^25.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.21"
  }
}
